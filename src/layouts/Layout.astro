---
import '../styles/global.css';
import { APP_VERSION as VERSION } from '../lib/version';
export interface Props {
  title?: string;
}
const { title = 'פרקטיקום · Ariel University' } = Astro.props;
---
<!DOCTYPE html>
<html lang="he" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="0" />
    <title>{title} · {VERSION}</title>
    <meta name="app-version" content={VERSION} />
    <!-- PWA -->
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#7a1e2b" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1c0b0e" media="(prefers-color-scheme: dark)" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="פרקטיקום" />
    <link rel="apple-touch-icon" href="/icon.svg" />
    <!-- Theme bootstrap: runs synchronously before first paint to eliminate flash.
         Must stay a plain (non-deferred) script so it blocks rendering briefly. -->
    <script>
      (function () {
        var THEME_KEY = 'practicum_theme';
        var saved = '';
        try { saved = localStorage.getItem(THEME_KEY) || ''; } catch (_) {}
        var mode = saved || 'auto';
        var isDark =
          mode === 'dark' ||
          (mode === 'auto' && (function () {
            var h = new Date().getHours();
            return h >= 19 || h < 7;
          })());
        document.documentElement.setAttribute('data-theme', isDark ? 'dark' : 'light');
      })();
    </script>
    <script define:vars={{ BUILD: VERSION }}>
      // ── Auto-update: never let a device get stuck on an old build ──────────
      // 1) Register the SW, force an update check on load + periodically, and
      //    reload as soon as a new SW takes control (new deploy → fresh app).
      if ('serviceWorker' in navigator) {
        let reloaded = false;
        navigator.serviceWorker.addEventListener('controllerchange', () => {
          if (reloaded) return; reloaded = true; location.reload();
        });
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').then((reg) => {
            reg.update();
            setInterval(() => reg.update(), 60000);
          }).catch(() => {});
        });
      }
      // 2) Belt-and-suspenders: on load AND every time the app is re-focused,
      //    fetch the live HTML (cache-busted) and compare its build to ours. If
      //    the server is newer, purge caches + SW and hard-reload. This rescues
      //    even a stubborn iOS PWA that's serving a stale shell.
      async function checkFreshBuild() {
        try {
          const res = await fetch('/?_v=' + Date.now(), { cache: 'no-store' });
          const html = await res.text();
          const m = html.match(/name="app-version" content="([^"]+)"/);
          const live = m && m[1];
          if (live && live !== BUILD) {
            if ('serviceWorker' in navigator) {
              const regs = await navigator.serviceWorker.getRegistrations();
              await Promise.all(regs.map((r) => r.unregister()));
            }
            if (window.caches) {
              const keys = await caches.keys();
              await Promise.all(keys.map((k) => caches.delete(k)));
            }
            location.reload();
          }
        } catch (_) {}
      }
      window.addEventListener('load', () => setTimeout(checkFreshBuild, 1500));
      document.addEventListener('visibilitychange', () => { if (!document.hidden) checkFreshBuild(); });
    </script>
  </head>
  <body class="min-h-screen">
    <slot />
    <!-- Version stamp for debugging -->
    <div id="version-stamp" style="position:fixed;bottom:4px;left:8px;font-family:monospace;font-size:11.5px;font-weight:700;color:#5a1020;background:rgba(255,255,255,0.7);padding:1px 5px;border-radius:5px;pointer-events:none;z-index:1">
      {VERSION}
    </div>
  </body>
</html>
